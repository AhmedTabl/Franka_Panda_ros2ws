<?xml version="1.0"?>
<package format="3">
  <name>orcahand_description</name>
  <version>0.1.0</version>
  <description>URDF description of the ORCA hand</description>

  <maintainer email="arturo.roberti@outlook.com">Arturo Roberti</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>

  <export>
    <architecture_independent/>
    <!-- Local patch: declare the ROS 2 build type explicitly so colcon does
         not classify this package as ROS 1 catkin (the catkin
         buildtool_depend above otherwise wins the auto-detection and the
         package never lands on AMENT_PREFIX_PATH). -->
    <build_type>ament_cmake</build_type>
  </export>
</package>

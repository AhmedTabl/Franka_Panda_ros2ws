<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>surgical_hand_skills</name>
  <version>0.1.0</version>
  <description>
    Named hand poses and (later) surgical manipulation primitives for the
    surgical hand. Currently provides the hand_pose_cli tool that sends
    named poses to the hand joint position controller.
  </description>
  <maintainer email="ahmed.tabl@torontomu.ca">Ahmed Tabl</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>surgical_hand_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <exec_depend>surgical_hand_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
